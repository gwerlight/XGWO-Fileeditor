<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.gwerlight.xgwo.fileedit</groupId>
    <artifactId>xgwo-fileedit-parent</artifactId>
    <version>0.6.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>xgwo-fileedit</name>

    <modules>
        <module>core</module>
        <module>desktop</module>
        <!-- später: <module>web</module> (Spring Boot / Vaadin, nutzt nur "core") -->
    </modules>

    <properties>
        <!-- Auf die installierte LTS-Version anheben (z. B. 25), sobald das JDK vorhanden ist -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ph-schematron 10.0.1 ist geprüft; die übrigen Versionen bitte in IntelliJ/Maven Central auf aktuell heben -->
        <ph-schematron.version>10.2.0</ph-schematron.version>
        <flatlaf.version>3.7.2</flatlaf.version>
        <rsyntaxtextarea.version>3.6.0</rsyntaxtextarea.version>
        <!-- Spock 2.4 gehört zu Groovy 4.x; Versionen bitte bei Gelegenheit auf aktuell heben -->
        <spock.version>2.4-M6-groovy-4.0</spock.version>
        <groovy.version>4.0.26</groovy.version>
        <gmavenplus.version>4.1.1</gmavenplus.version>
        <jacoco.version>0.8.13</jacoco.version>
        <pmd-plugin.version>3.26.0</pmd-plugin.version>
        <spotbugs-plugin.version>4.9.3.0</spotbugs-plugin.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <!-- Mindestanteil abgedeckter Zeilen je Modul; Build schlägt in "verify" darunter fehl -->
        <jacoco.minimum.line>0.80</jacoco.minimum.line>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>de.gwerlight.xgwo.fileedit</groupId>
                <artifactId>xgwo-fileedit-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.helger.schematron</groupId>
                <artifactId>ph-schematron-schxslt</artifactId>
                <version>${ph-schematron.version}</version>
            </dependency>
            <dependency>
                <groupId>org.spockframework</groupId>
                <artifactId>spock-bom</artifactId>
                <version>${spock.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy</artifactId>
                <version>${groovy.version}</version>
            </dependency>
            <dependency>
                <groupId>com.formdev</groupId>
                <artifactId>flatlaf</artifactId>
                <version>${flatlaf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.formdev</groupId>
                <artifactId>flatlaf-extras</artifactId>
                <version>${flatlaf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fifesoft</groupId>
                <artifactId>rsyntaxtextarea</artifactId>
                <version>${rsyntaxtextarea.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Test-Werkzeuge für alle Module: Groovy-Tests, Surefire und Testabdeckung (JaCoCo) -->
    <build>
        <plugins>
            <!-- kompiliert src/test/groovy -->
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>${gmavenplus.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <includes>
                        <include>**/*Spec.java</include>
                        <include>**/*Spec.groovy</include>
                    </includes>
                    <!-- Swing-Tests müssen auch ohne Display (CI) laufen -->
                    <systemPropertyVariables>
                        <java.awt.headless>true</java.awt.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Agent für Surefire, Bericht unter target/site/jacoco, Mindestabdeckung (je Modul überschreibbar) in "check" -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.line}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Statische Codeanalyse (PMD). Zunächst nur berichtend: Verstöße erscheinen als Warnungen im Build,
                 brechen ihn aber nicht ab (failOnViolation=false). Bericht: target/pmd.xml bzw. target/site/pmd.html -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd-plugin.version}</version>
                <configuration>
                    <targetJdk>${maven.compiler.release}</targetJdk>
                    <rulesets>
                        <ruleset>rulesets/java/quickstart.xml</ruleset>
                    </rulesets>
                    <failOnViolation>false</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>pmd</goal>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Fehlermuster und Sicherheitslücken im Bytecode (SpotBugs + find-sec-bugs, z. B. XXE, Pfadmanipulation).
                 Wie PMD zunächst nur berichtend. Bericht: target/spotbugsXml.xml -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>false</failOnError>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
